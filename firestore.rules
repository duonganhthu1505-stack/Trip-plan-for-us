rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthorizedEmail() {
      // The user requested to simplify the login by just typing the email without Google popup.
      // Since the frontend handles the allowedEmails check, we relax this rule.
      return true;
    }


    // ----------------------------------------------------
    // User Profiles (/users/{userId})
    // ----------------------------------------------------
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('activeTripId' in data) || (data.activeTripId is string && data.activeTripId.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /users/{userId} {
      allow get, list: if isAuthorizedEmail();
      allow create: if isValidId(userId) && request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().id == userId;
      allow update: if isValidId(userId) && request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().id == existing().id;
      allow delete: if isValidId(userId) && request.auth.uid == userId;
    }

    // ----------------------------------------------------
    // Trips (/trips/{tripId})
    // ----------------------------------------------------
    function isValidTrip(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.destination is string && data.destination.size() > 0 && data.destination.size() <= 200 &&
             data.startDate is string && data.startDate.size() <= 32 &&
             data.endDate is string && data.endDate.size() <= 32 &&
             data.status in ['Planning', 'Upcoming', 'Ongoing', 'Completed'] &&
             (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 256)) &&
             (!('travelers' in data) || (data.travelers is number && data.travelers >= 1 && data.travelers <= 100)) &&
             (!('travelerNames' in data) || (data.travelerNames is string && data.travelerNames.size() <= 200)) &&
             (!('transport' in data) || (data.transport is string && data.transport.size() <= 200)) &&
             (!('hotel' in data) || (data.hotel is string && data.hotel.size() <= 300)) &&
             // Uploaded covers are compressed to <= 600 KB before being encoded as a data URL.
             // Base64 adds ~33% overhead, so allow enough room while staying below Firestore's 1 MiB document limit.
             (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 900000)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             (!('plannedBudget' in data) || data.plannedBudget is number) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /trips/{tripId} {
      allow get, list: if isAuthorizedEmail();
      allow create: if isValidId(tripId) && isAuthorizedEmail() &&
                       isValidTrip(incoming()) &&
                       incoming().id == tripId;
      allow update: if isValidId(tripId) && isAuthorizedEmail() &&
                       isValidTrip(incoming()) &&
                       incoming().id == existing().id;
      allow delete: if isValidId(tripId) && isAuthorizedEmail();

      function isValidActivity(data) {
        return data.id is string && data.id.size() <= 128 &&
               data.tripId is string && data.tripId == tripId &&
               data.ownerId is string && data.ownerId.size() <= 128 &&
               data.date is string && data.date.size() <= 32 &&
               data.time is string && data.time.size() <= 16 &&
               data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
               data.location is string && data.location.size() <= 300 &&
               data.category is string && data.category.size() <= 64 &&
               (!('plannedCost' in data) || data.plannedCost is number) &&
               (!('actualCost' in data) || data.actualCost is number) &&
               (!('note' in data) || (data.note is string && data.note.size() <= 2000)) &&
               (!('mapUrl' in data) || (data.mapUrl is string && data.mapUrl.size() <= 1000)) &&
               (!('order' in data) || data.order is number) &&
               (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
               (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
      }

      match /activities/{activityId} {
        allow get, list: if isAuthorizedEmail();
        allow create: if isValidId(tripId) && isValidId(activityId) && isAuthorizedEmail() && isValidActivity(incoming()) && incoming().id == activityId;
        allow update: if isValidId(tripId) && isValidId(activityId) && isAuthorizedEmail() && isValidActivity(incoming()) && incoming().tripId == existing().tripId && incoming().id == existing().id;
        allow delete: if isValidId(tripId) && isValidId(activityId) && isAuthorizedEmail();
      }

      function isValidBudgetItem(data) {
        return data.id is string && data.id.size() <= 128 &&
               data.tripId is string && data.tripId == tripId &&
               data.ownerId is string && data.ownerId.size() <= 128 &&
               (!('activityId' in data) || (data.activityId is string && data.activityId.size() <= 128)) &&
               data.category is string && data.category.size() <= 64 &&
               data.item is string && data.item.size() > 0 && data.item.size() <= 200 &&
               data.quantity is number && data.quantity >= 0 &&
               data.unit is string && data.unit.size() <= 64 &&
               (!('plannedCost' in data) || data.plannedCost is number) &&
               (!('actualCost' in data) || data.actualCost is number) &&
               (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
               (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
               (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
      }

      match /budget_items/{itemId} {
        allow get, list: if isAuthorizedEmail();
        allow create: if isValidId(tripId) && isValidId(itemId) && isAuthorizedEmail() && isValidBudgetItem(incoming()) && incoming().id == itemId;
        allow update: if isValidId(tripId) && isValidId(itemId) && isAuthorizedEmail() && isValidBudgetItem(incoming()) && incoming().tripId == existing().tripId && incoming().id == existing().id;
        allow delete: if isValidId(tripId) && isValidId(itemId) && isAuthorizedEmail();
      }

      function isValidPlace(data) {
        return data.id is string && data.id.size() <= 128 &&
               data.tripId is string && data.tripId == tripId &&
               data.ownerId is string && data.ownerId.size() <= 128 &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               data.category is string && data.category.size() <= 64 &&
               data.address is string && data.address.size() <= 300 &&
               data.status in ['Want to go', 'Planned', 'Visited', 'Skipped'] &&
               (!('mapUrl' in data) || (data.mapUrl is string && data.mapUrl.size() <= 1000)) &&
               (!('estimatedCost' in data) || data.estimatedCost is number) &&
               (!('openingHours' in data) || (data.openingHours is string && data.openingHours.size() <= 128)) &&
               (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
               (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
               (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
               (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
      }

      match /places/{placeId} {
        allow get, list: if isAuthorizedEmail();
        allow create: if isValidId(tripId) && isValidId(placeId) && isAuthorizedEmail() && isValidPlace(incoming()) && incoming().id == placeId;
        allow update: if isValidId(tripId) && isValidId(placeId) && isAuthorizedEmail() && isValidPlace(incoming()) && incoming().tripId == existing().tripId && incoming().id == existing().id;
        allow delete: if isValidId(tripId) && isValidId(placeId) && isAuthorizedEmail();
      }

      function isValidChecklistItem(data) {
        return data.id is string && data.id.size() <= 128 &&
               data.tripId is string && data.tripId == tripId &&
               data.ownerId is string && data.ownerId.size() <= 128 &&
               data.category is string && data.category.size() <= 64 &&
               data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
               data.completed is bool &&
               (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
               (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
               (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
      }

      match /checklist/{itemId} {
        allow get, list: if isAuthorizedEmail();
        allow create: if isValidId(tripId) && isValidId(itemId) && isAuthorizedEmail() && isValidChecklistItem(incoming()) && incoming().id == itemId;
        allow update: if isValidId(tripId) && isValidId(itemId) && isAuthorizedEmail() && isValidChecklistItem(incoming()) && incoming().tripId == existing().tripId && incoming().id == existing().id;
        allow delete: if isValidId(tripId) && isValidId(itemId) && isAuthorizedEmail();
      }

      function isValidNote(data) {
        return data.id is string && data.id.size() <= 128 &&
               data.tripId is string && data.tripId == tripId &&
               data.ownerId is string && data.ownerId.size() <= 128 &&
               data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
               data.category is string && data.category.size() <= 64 &&
               data.content is string && data.content.size() <= 5000 &&
               (!('images' in data) || (data.images is list && data.images.size() <= 10)) &&
               (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
               (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
      }

      match /notes/{noteId} {
        allow get, list: if isAuthorizedEmail();
        allow create: if isValidId(tripId) && isValidId(noteId) && isAuthorizedEmail() && isValidNote(incoming()) && incoming().id == noteId;
        allow update: if isValidId(tripId) && isValidId(noteId) && isAuthorizedEmail() && isValidNote(incoming()) && incoming().tripId == existing().tripId && incoming().id == existing().id;
        allow delete: if isValidId(tripId) && isValidId(noteId) && isAuthorizedEmail();
      }

      function isValidService(data) {
        return data.id is string && data.id.size() <= 128 &&
               data.tripId is string && data.tripId == tripId &&
               data.ownerId is string && data.ownerId.size() <= 128 &&
               data.category is string && data.category.size() <= 64 &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               data.isChosen is bool &&
               (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
               (!('distanceToCenter' in data) || (data.distanceToCenter is string && data.distanceToCenter.size() <= 200)) &&
               (!('pricePerUnit' in data) || data.pricePerUnit is number) &&
               (!('unitLabel' in data) || (data.unitLabel is string && data.unitLabel.size() <= 64)) &&
               (!('weekendSurcharge' in data) || data.weekendSurcharge is number) &&
               (!('deposit' in data) || data.deposit is number) &&
               (!('totalEstimate' in data) || data.totalEstimate is number) &&
               (!('amenities' in data) || (data.amenities is list && data.amenities.size() <= 30)) &&
               (!('pros' in data) || (data.pros is list && data.pros.size() <= 30)) &&
               (!('cons' in data) || (data.cons is list && data.cons.size() <= 30)) &&
               (!('photos' in data) || (data.photos is list && data.photos.size() <= 10)) &&
               (!('hisNote' in data) || (data.hisNote is string && data.hisNote.size() <= 2000)) &&
               (!('herNote' in data) || (data.herNote is string && data.herNote.size() <= 2000)) &&
               (!('votes' in data) || data.votes is number) &&
               (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 64)) &&
               (!('linkUrl' in data) || (data.linkUrl is string && data.linkUrl.size() <= 1000)) &&
               (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
               (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
      }

      match /services/{serviceId} {
        allow get, list: if isAuthorizedEmail();
        allow create: if isValidId(tripId) && isValidId(serviceId) && isAuthorizedEmail() && isValidService(incoming()) && incoming().id == serviceId;
        allow update: if isValidId(tripId) && isValidId(serviceId) && isAuthorizedEmail() && isValidService(incoming()) && incoming().tripId == existing().tripId && incoming().id == existing().id;
        allow delete: if isValidId(tripId) && isValidId(serviceId) && isAuthorizedEmail();
      }
    }

    function isValidAppConfig(data) {
      return data.id is string && data.id.size() <= 64 && data.allowedEmails is list;
    }

    match /app_config/{configId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
