rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Trip covers only. The current app uses its existing email allow-list in the UI
    // rather than Firebase Auth, so writes are tightly limited by path, MIME type and size.
    match /trip-covers/{coverFile} {
      allow read: if true;
      allow write: if request.resource != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
